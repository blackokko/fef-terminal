# FEF Terminal — environment configuration template.
# Copy to `.env` and fill in. The sidecar reads these at startup.
# NOTHING secret lives in this file — the QuantData token lives in
# ~/.quantdata-mcp/config.json (provisioned via `quantdata-mcp setup`).

# ───────────────────────── IBKR connection ─────────────────────────
# By DEFAULT the sidecar runs a MOCK IBKR provider (no broker needed) so a
# fresh clone boots without TWS. To connect to a real TWS/Gateway, set
# FEF_PROVIDER_IBKR=false (or "real").
FEF_PROVIDER_IBKR=true            # true = mock (safe default); false = live TWS/Gateway
FEF_IBKR_HOST=127.0.0.1
FEF_IBKR_PORT=7497                # 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live
FEF_IBKR_CLIENT_ID=1

# ───────────────────────── Trading safety ──────────────────────────
# BOTH must be flipped before any real order is placed. Defaults are safe.
FEF_LIVE_TRADING=false            # false = dry-run only; orders are simulated, never sent
FEF_REQUIRE_PAPER_ACCOUNT=true    # refuse any account not prefixed 'DU' (IBKR paper). Keep ON until going live.
FEF_ALLOW_CREDIT_SPREADS=false    # structural guard: short legs only allowed inside spreads when true
FEF_MAX_CONTRACTS_PER_TRADE=20    # hard cap per auto-trade fire

# ───────────────────────── QuantData ───────────────────────────────
# Token + instance live in ~/.quantdata-mcp/config.json (run `quantdata-mcp setup`).
# Override the config dir here only if it's not in the default home location.
# QUANTDATA_MCP_CONFIG_DIR=

# ───────────────────────── Database ────────────────────────────────
# Defaults to ~/.fef-terminal/signal_log.db. Override to point at a copied DB.
# FEF_DB_URL=sqlite+aiosqlite:///C:/Users/you/.fef-terminal/signal_log.db

# ───────────────────────── Engine tuning (the 4 knobs) ─────────────
FEF_WALL_PROXIMITY_PTS=5
FEF_WALL_COLLAPSE_PCT=0.20
FEF_WALL_COLLAPSE_FLOOR_M=5
FEF_ABSORPTION_FE_MIN=5
FEF_USE_CONFIDENCE_FLOOR=false

# ───────────────────────── Loop cadences (seconds) ─────────────────
FEF_LOOP_INTERVAL_SEC=120         # FEF engine iteration (2 min)
FEF_QUANTDATA_POLL_INTERVAL_SEC=15
FEF_VIX_POLL_INTERVAL_SEC=60
SPX_WATCHER_INTERVAL_SEC=0.1      # SPX-target exit watcher hot loop
RUNNER_PROTECT_INTERVAL_SEC=5

# ───────────────────────── Option chain capture (added 2026-05-26) ─
FEF_CHAIN_CAPTURE_ENABLED=true    # captures ATM±25pt chain every 2 min during RTH
FEF_CHAIN_CAPTURE_INTERVAL_SEC=120

# ───────────────────────── Nightly chain ───────────────────────────
FEF_AUTO_WALKFORWARD_HOUR=22      # UTC hour for nightly persist + analytics chain

# ───────────────────────── Dev / mock knobs ────────────────────────
# FEF_DISABLE_AUTO_LOOP=false
# FEF_MOCK_SCRIPTED_DAY=
# FEF_MOCK_SPEEDUP=1

# ───────────────────────── SPY mirror (added 2026-07-27) ───────────
# FEF_SPY_MIRROR_ENABLED=true          # env kill switch (config spy_mirror_enabled also gates)
# FEF_SPY_MIRROR_SPOT_MAX_AGE_SEC=10   # fresh-or-skip plan-anchor bound; 0 = mirror always skips
#                                      # (prefer FEF_SPY_MIRROR_ENABLED=false for intentional kills)
# OPERATOR NOTE: mirror hit-rate depends on spx_entry_order_type. With
# "market" (current) the fire-commit warm kick lands inside the bound
# (~80-95% hit). Flipping back to "chase_limit" puts the 20s entry chase
# between kick and mirror resolve — the mirror will then SKIP most fires
# (audited spot_fetch_failed) until a streaming SPY quote feed ships.
